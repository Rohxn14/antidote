# Local Docker defaults. Copy to .env (local) or .env.cloud (FalkorDB Cloud).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=antidote

# LLM (only needed to record new agent outputs; the demo replays fixtures).
# Groq by default; for Gemini set LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
